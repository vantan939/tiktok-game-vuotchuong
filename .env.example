# Sao chép thành .env (file .env không được commit) rồi điền giá trị thật.

# Giọng MC qua genmax (https://api.genmax.io). Thiếu hai dòng bắt buộc thì MC dùng giọng của trình duyệt.
GENMAX_API_KEY=
GENMAX_VOICE_ID=

# Tùy chọn. Nhà cung cấp của giọng: elevenlabs (mặc định), minimax hoặc capcut
GENMAX_PROVIDER=elevenlabs
# Bỏ trống thì dùng model mặc định theo nhà cung cấp (eleven_flash_v2_5 hỗ trợ tiếng Việt, nhanh và rẻ; eleven_multilingual_v2 KHÔNG hỗ trợ tiếng Việt; speech-2.8-turbo; capcut)
GENMAX_MODEL=
GENMAX_LANGUAGE=vi
GENMAX_SPEED=1
# Chỉ dùng cho minimax và capcut (-12 đến 12)
GENMAX_PITCH=0
# Hạn mức ký tự tạo giọng mới mỗi giờ để không cạn credit (câu đã có trong cache không tính)
GENMAX_BUDGET_CHARS_PER_HOUR=6000

# Kết nối live TikTok (tiktok-live-connector, KHÔNG chính thức). TIKTOK_USERNAME là @username của chủ phòng, không cần dấu @.
# Bỏ trống thì server không nhận live (dùng --replay file.json hoặc chế độ demo để thử).
TIKTOK_USERNAME=
# Khóa Euler Stream (tùy chọn): thư viện dùng máy chủ ký của Euler để kết nối; khóa giúp ổn định hơn. Xem README.
EULER_API_KEY=

# Cổng của server (WebSocket và HTTP)
WS_PORT=8080
